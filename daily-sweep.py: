#!/usr/bin/env python3
"""
Cathedral Network — Daily Ground Truth Automation v1.4.0
Generates the daily index.html, archives yesterday's summary,
updates archive.html and sitemap.xml.
"""

from datetime import datetime, timedelta
from pathlib import Path

# --- Configuration ---
SITE_DIR = Path("../cathedral-site")  # Adjust to your actual folder
TODAY = datetime.now()
YESTERDAY = TODAY - timedelta(days=1)
DATE_STRING = TODAY.strftime("%A, %d %B %Y")  # e.g. Tuesday, 27 May 2026
DATE_SHORT = TODAY.strftime("%Y-%m-%d")        # e.g. 2026-05-27
YESTERDAY_SHORT = YESTERDAY.strftime("%Y-%m-%d")

# --- 1. Archive yesterday's index.html ---
index_path = SITE_DIR / "index.html"
if index_path.exists():
    archive_name = f"ground-truth-{YESTERDAY_SHORT}.html"
    archive_path = SITE_DIR / archive_name
    index_path.rename(archive_path)
    print(f"Archived yesterday's index.html → {archive_name}")
else:
    print("No index.html found to archive.")

# --- 2. Write today's index.html ---
# The full HTML is inserted here. In practice, the Core generates this content
# and the script populates it. For demonstration, we use a minimal template.
html_content = f"""<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <link rel="manifest" href="/manifest.json">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Cathedral Network — Ground Truth</title>
  <style>
    body {{ font-family: system-ui, sans-serif; margin: 0; padding: 0; line-height: 1.6; color: #1a1a1a; background: #fafafa; }}
    .content {{ max-width: 700px; margin: 2rem auto; padding: 0 1rem; }}
    h1 {{ font-size: 1.8rem; margin-bottom: 0.25rem; }}
    .date {{ color: #555; font-size: 0.9rem; margin-bottom: 2rem; }}
    .nav {{ margin-bottom: 1rem; }}
    .nav a {{ color: #0055aa; text-decoration: none; margin-right: 1rem; }}
    .footer {{ margin-top: 3rem; font-style: italic; color: #888; border-top: 1px solid #ddd; padding-top: 1rem; }}
    a {{ color: #0055aa; }}
    .cathedral-banner {{ background: #b39ddb; padding: 2rem 1rem; border-bottom: 1px solid rgba(255,255,255,0.2); }}
    .banner-content {{ max-width: 1200px; margin: 0 auto; display: flex; align-items: center; gap: 1.5rem; }}
    .logo-mark svg {{ display: block; }}
    .wordmark h1 {{ font-family: 'Helvetica Neue', Arial, sans-serif; font-weight: 300; font-size: 1.8rem; letter-spacing: 0.15em; color: white; margin: 0; }}
    .tagline {{ font-family: 'Helvetica Neue', Arial, sans-serif; font-weight: 300; font-size: 0.9rem; letter-spacing: 0.1em; color: rgba(255,255,255,0.8); margin: 0.25rem 0 0 0; }}
    @media (max-width: 600px) {{ .banner-content {{ flex-direction: column; text-align: center; gap: 1rem; }} .wordmark h1 {{ font-size: 1.5rem; }} }}
  </style>
</head>
<body>
  <header class="cathedral-banner">
    <div class="banner-content">
      <div class="logo-mark">
        <svg viewBox="0 0 120 140" width="60" height="70" aria-label="Cathedral Network logo">
          <path d="M60 130 L55 20 L60 5 L65 20 Z" fill="white"/>
          <circle cx="60" cy="25" r="2" fill="white"/><circle cx="55" cy="40" r="2" fill="white"/><circle cx="65" cy="40" r="2" fill="white"/>
          <circle cx="50" cy="55" r="2" fill="white"/><circle cx="60" cy="55" r="2" fill="white"/><circle cx="70" cy="55" r="2" fill="white"/>
          <circle cx="45" cy="70" r="2" fill="white"/><circle cx="55" cy="70" r="2" fill="white"/><circle cx="65" cy="70" r="2" fill="white"/><circle cx="75" cy="70" r="2" fill="white"/>
          <circle cx="50" cy="85" r="2" fill="white"/><circle cx="60" cy="85" r="2" fill="white"/><circle cx="70" cy="85" r="2" fill="white"/>
          <circle cx="55" cy="100" r="2" fill="white"/><circle cx="65" cy="100" r="2" fill="white"/>
          <path d="M60 25 L55 40 M60 25 L65 40 M55 40 L50 55 M65 40 L70 55" stroke="white" stroke-width="0.5" fill="none" opacity="0.6"/>
          <path d="M30 60 A30 30 0 1 1 90 60" stroke="white" stroke-width="2" fill="none"/>
        </svg>
      </div>
      <div class="wordmark">
        <h1>CATHEDRAL NETWORK</h1>
        <p class="tagline">A cathedral that watches</p>
      </div>
    </div>
  </header>
  <div class="content">
    <div class="nav">
      <a href="index.html">Ground Truth</a>
      <a href="about.html">About</a>
      <a href="archive.html">Archive</a>
    </div>
    <h1>Cathedral Network — Ground Truth Summary</h1>
    <div class="date">{DATE_STRING}</div>
    <p><!-- INSERT DAILY SUMMARY HERE --></p>
    <div class="footer">
      <strong>Always and Forever, Coco. Always and Forever.</strong>
    </div>
  </div>
  <script>
    if ('serviceWorker' in navigator) {{
      navigator.serviceWorker.register('/service-worker.js')
        .then(() => console.log('Service Worker registered'))
        .catch((err) => console.log('Service Worker failed', err));
    }}
  </script>
</body>
</html>
"""

with open(index_path, "w", encoding="utf-8") as f:
    f.write(html_content)
print(f"Created today's index.html for {DATE_STRING}")

# --- 3. Update archive.html ---
archive_path = SITE_DIR / "archive.html"
if archive_path.exists():
    content = archive_path.read_text(encoding="utf-8")
    new_link = f'    <li><a href="ground-truth-{YESTERDAY_SHORT}.html">{YESTERDAY.strftime("%A, %d %B %Y")}</a></li>\n'
    insert_at = content.find("<ul>") + len("<ul>") + 1  # after the opening <ul> and newline
    content = content[:insert_at] + new_link + content[insert_at:]
    archive_path.write_text(content, encoding="utf-8")
    print(f"Updated archive.html with {YESTERDAY_SHORT}")
else:
    print("archive.html not found. Skipping archive update.")

# --- 4. Update sitemap.xml ---
sitemap_path = SITE_DIR / "sitemap.xml"
if sitemap_path.exists():
    content = sitemap_path.read_text(encoding="utf-8")
    new_url = f"""  <url>
    <loc>https://cathedral-network.netlify.app/ground-truth-{YESTERDAY_SHORT}.html</loc>
    <lastmod>{DATE_SHORT}</lastmod>
    <changefreq>never</changefreq>
    <priority>0.7</priority>
  </url>
"""
    insert_at = content.find("</urlset>")
    content = content[:insert_at] + new_url + content[insert_at:]
    sitemap_path.write_text(content, encoding="utf-8")
    print(f"Updated sitemap.xml with {YESTERDAY_SHORT}")
else:
    print("sitemap.xml not found. Skipping sitemap update.")

print("Daily sweep complete. Ready for Netlify deployment.")
